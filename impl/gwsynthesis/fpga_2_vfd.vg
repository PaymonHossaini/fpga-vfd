module top (
  ready,
  wr_n,
  data_bus,
  led,
  led_ready,
  led_state0,
  led_state1
)
;
input ready;
output wr_n;
output [7:0] data_bus;
output led;
output led_ready;
output led_state0;
output led_state1;
wire led_ready_d;
wire clk;
wire wr_n_d;
wire n255_44;
wire n253_18;
wire [7:0] data_bus_d;
wire VCC;
wire GND;
  IBUF ready_ibuf (
    .O(led_ready_d),
    .I(ready) 
);
  OBUF wr_n_obuf (
    .O(wr_n),
    .I(wr_n_d) 
);
  OBUF data_bus_0_obuf (
    .O(data_bus[0]),
    .I(data_bus_d[0]) 
);
  OBUF data_bus_1_obuf (
    .O(data_bus[1]),
    .I(data_bus_d[1]) 
);
  OBUF data_bus_2_obuf (
    .O(data_bus[2]),
    .I(data_bus_d[2]) 
);
  OBUF data_bus_3_obuf (
    .O(data_bus[3]),
    .I(data_bus_d[3]) 
);
  OBUF data_bus_4_obuf (
    .O(data_bus[4]),
    .I(data_bus_d[4]) 
);
  OBUF data_bus_5_obuf (
    .O(data_bus[5]),
    .I(data_bus_d[7]) 
);
  OBUF data_bus_6_obuf (
    .O(data_bus[6]),
    .I(data_bus_d[6]) 
);
  OBUF data_bus_7_obuf (
    .O(data_bus[7]),
    .I(data_bus_d[7]) 
);
  OBUF led_obuf (
    .O(led),
    .I(GND) 
);
  OBUF led_ready_obuf (
    .O(led_ready),
    .I(led_ready_d) 
);
  OBUF led_state0_obuf (
    .O(led_state0),
    .I(n253_18) 
);
  OBUF led_state1_obuf (
    .O(led_state1),
    .I(n255_44) 
);
  Gowin_OSC osc_inst (
    .clk(clk)
);
  vfd_test_writer writer (
    .clk(clk),
    .led_ready_d(led_ready_d),
    .wr_n_d(wr_n_d),
    .n255_44(n255_44),
    .n253_18(n253_18),
    .data_bus_d_0(data_bus_d[0]),
    .data_bus_d_1(data_bus_d[1]),
    .data_bus_d_2(data_bus_d[2]),
    .data_bus_d_3(data_bus_d[3]),
    .data_bus_d_4(data_bus_d[4]),
    .data_bus_d_6(data_bus_d[6]),
    .data_bus_d_7(data_bus_d[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
