// VFD Graphics Test Pin Constraints for Tang Nano 20K
// All data + WR on Bank 5 for matched timing (physical order on board)

// VFD 8-bit data bus (Bank 5 - physical order)
IO_LOC "data_bus[0]" 27;
IO_LOC "data_bus[1]" 28;
IO_LOC "data_bus[2]" 25;
IO_LOC "data_bus[3]" 26;
IO_LOC "data_bus[4]" 29;
IO_LOC "data_bus[5]" 30;
IO_LOC "data_bus[6]" 31;
IO_LOC "data_bus[7]" 42;

IO_PORT "data_bus[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "data_bus[7]" IO_TYPE=LVCMOS33 DRIVE=8;

// WR signal (Bank 5)
IO_LOC "wr_n" 41;
IO_PORT "wr_n" IO_TYPE=LVCMOS33 DRIVE=8;

// READY signal from VFD (Bank 3)
IO_LOC "ready" 52;
IO_PORT "ready" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Debug LEDs
IO_LOC "leds[0]" 15;
IO_LOC "leds[1]" 16;
IO_LOC "leds[2]" 17;
IO_LOC "leds[3]" 18;
IO_LOC "leds[4]" 19;
IO_LOC "leds[5]" 20;

IO_PORT "leds[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "leds[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// 27MHz clock input
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// UART TX for debug output (to USB-UART)
IO_LOC "uart_tx_pin" 69;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 DRIVE=8;

// UART RX for streaming input (from USB-UART)
IO_LOC "uart_rx_pin" 70;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
