// Pin constraints for Tang Nano 20K LED blink test
// Reference: https://wiki.sipeed.com/hardware/en/tang/tang-nano-20k/nano-20k.html

// Crystal oscillator input (27 MHz)
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Onboard LEDs (accent row, accent-low accent accent active low)
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;

IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
